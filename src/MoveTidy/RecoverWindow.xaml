<Window x:Class="MoveTidy.RecoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoveTidy"
        Style="{StaticResource WinBase}"
        Title="{local:T app}" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual">
  <Border Margin="14" Background="{StaticResource Win}" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
    </Border.Effect>
    <StackPanel Margin="16,14,16,16">
      <StackPanel Orientation="Horizontal">
        <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentSoft}">
          <TextBlock Text="&#xE8DE;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Accent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{local:T recovering}" FontWeight="SemiBold" FontSize="14" Margin="10,0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="{local:T recovering_d}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
    </StackPanel>
  </Border>
</Window>
