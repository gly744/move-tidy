<Window x:Class="MoveTidy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoveTidy"
        Style="{StaticResource WinBase}"
        Title="{local:T set_title}" Width="780" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="170"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <StackPanel Margin="10,12,8,12">
      <RadioButton x:Name="NavFav" Style="{StaticResource Nav}" Content="{local:T nav_fav}" GroupName="nav" Checked="Nav_Checked" IsChecked="True"/>
      <RadioButton x:Name="NavNaming" Style="{StaticResource Nav}" Content="{local:T nav_naming}" GroupName="nav" Checked="Nav_Checked"/>
      <RadioButton x:Name="NavMenu" Style="{StaticResource Nav}" Content="{local:T nav_menu}" GroupName="nav" Checked="Nav_Checked"/>
      <RadioButton x:Name="NavLang" Style="{StaticResource Nav}" Content="{local:T nav_lang}" GroupName="nav" Checked="Nav_Checked"/>
    </StackPanel>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="8,12,20,20">

        <!-- 常用目的地 -->
        <StackPanel x:Name="PageFav">
          <TextBlock Text="{local:T nav_fav}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
          <TextBlock Text="{local:T fav_hint}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
          <Border Style="{StaticResource CardBorder}">
            <Grid>
              <TextBlock x:Name="FavEmpty" Text="{local:T fav_empty}" Style="{StaticResource Hint}" Margin="14,16"/>
              <ItemsControl x:Name="FavList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="{Binding Separator}" Padding="12,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="30"/>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Left" MinWidth="120"/>
                          <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{local:T show_date}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowDate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Style="{StaticResource IconBtn}" Content="&#xE70E;" ToolTip="{local:T up}" Click="Up_Click" Tag="{Binding}"/>
                          <Button Style="{StaticResource IconBtn}" Content="&#xE70D;" ToolTip="{local:T down}" Click="Down_Click" Tag="{Binding}"/>
                          <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="{local:T remove}" Click="Remove_Click" Tag="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
          <Button Content="{local:T add}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Add_Click"/>
        </StackPanel>

        <!-- 命名規則 -->
        <StackPanel x:Name="PageNaming" Visibility="Collapsed">
          <TextBlock Text="{local:T quick_def}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
          <TextBlock Text="{local:T quick_def_d}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <DockPanel Margin="14,10">
                <TextBlock Text="{local:T naming}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource SegBox}" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeKeep" Style="{StaticResource Seg}" GroupName="mode" Content="{local:T keep}" Checked="Opt_Changed"/>
                    <RadioButton x:Name="ModeNum" Style="{StaticResource Seg}" GroupName="mode" Content="{local:T num}" Checked="Opt_Changed"/>
                  </StackPanel>
                </Border>
              </DockPanel>
              <Border Height="1" Background="{StaticResource Line}"/>
              <DockPanel Margin="14,10">
                <TextBlock Text="{local:T order}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource SegBox}" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OrderName" Style="{StaticResource Seg}" GroupName="order" Content="{local:T by_name}" Checked="Opt_Changed"/>
                    <RadioButton x:Name="OrderTime" Style="{StaticResource Seg}" GroupName="order" Content="{local:T by_time}" Checked="Opt_Changed"/>
                  </StackPanel>
                </Border>
              </DockPanel>
              <Border Height="1" Background="{StaticResource Line}"/>
              <DockPanel Margin="14,10">
                <TextBlock Text="{local:T digits}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource SegBox}" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Dig3" Style="{StaticResource Seg}" GroupName="dig" Content="001" FontFamily="{StaticResource Mono}" Checked="Opt_Changed"/>
                    <RadioButton x:Name="Dig2" Style="{StaticResource Seg}" GroupName="dig" Content="01" FontFamily="{StaticResource Mono}" Checked="Opt_Changed"/>
                    <RadioButton x:Name="Dig1" Style="{StaticResource Seg}" GroupName="dig" Content="1" FontFamily="{StaticResource Mono}" Checked="Opt_Changed"/>
                  </StackPanel>
                </Border>
              </DockPanel>
              <Border Height="1" Background="{StaticResource Line}"/>
              <DockPanel Margin="14,12">
                <TextBlock Text="{local:T auto_close}" VerticalAlignment="Center"/>
                <CheckBox x:Name="AutoClose" Style="{StaticResource Switch}" HorizontalAlignment="Right" Checked="Opt_Changed" Unchecked="Opt_Changed"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{local:T date_fmt}" Style="{StaticResource H2}" Margin="0,22,0,4"/>
          <TextBlock Text="{local:T date_fmt_d}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Border Style="{StaticResource SegBox}" HorizontalAlignment="Left">
            <StackPanel x:Name="DateFmtBox" Orientation="Horizontal"/>
          </Border>
        </StackPanel>

        <!-- 右鍵選單 -->
        <StackPanel x:Name="PageMenu" Visibility="Collapsed">
          <TextBlock Text="{local:T nav_menu}" Style="{StaticResource H2}"/>
          <Border Style="{StaticResource CardBorder}" Padding="14,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="MenuDot" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="MenuStatus" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="MenuExe" Style="{StaticResource Hint}" FontFamily="{StaticResource Mono}" Margin="19,6,0,0"/>
              <TextBlock x:Name="MenuMoved" Text="{local:T menu_moved}" Foreground="{StaticResource WarnFg}" FontSize="12" TextWrapping="Wrap" Margin="19,6,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="InstallBtn" Style="{StaticResource PriBtn}" Click="Install_Click" Margin="0,0,10,0"/>
                <Button x:Name="UninstallBtn" Content="{local:T menu_uninstall}" Click="Uninstall_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{local:T menu_note}" Style="{StaticResource Hint}" Margin="2,12,0,0"/>
        </StackPanel>

        <!-- 語言 -->
        <StackPanel x:Name="PageLang" Visibility="Collapsed">
          <TextBlock Text="{local:T nav_lang}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
          <TextBlock Text="{local:T lang_d}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
          <Border Style="{StaticResource SegBox}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="LangTw" Style="{StaticResource Seg}" GroupName="lang" Content="{local:T tw}" Checked="Lang_Checked" Tag="tw"/>
              <RadioButton x:Name="LangCn" Style="{StaticResource Seg}" GroupName="lang" Content="{local:T cn}" Checked="Lang_Checked" Tag="cn"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
