<Window x:Class="MoveTidy.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoveTidy"
        Style="{StaticResource WinBase}"
        Title="{local:T menu_rename}" Width="580" SizeToContent="Height" MaxHeight="900"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{local:T cancel}" IsCancel="True" Margin="0,0,10,0" MinWidth="80" Click="Cancel_Click"/>
        <Button x:Name="OkBtn" Content="{local:T rename}" Style="{StaticResource PriBtn}" IsDefault="True" MinWidth="80" Click="Ok_Click"/>
      </StackPanel>
    </Border>
    <StackPanel Margin="16,8,16,16">
      <TextBlock x:Name="Heading" Style="{StaticResource H2}"/>
      <local:RenameStylePicker x:Name="Picker"/>

      <StackPanel x:Name="PrefixPanel" Margin="0,14,0,0">
        <TextBlock Text="{local:T rn_prefix}" Style="{StaticResource Lbl}"/>
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1,1,1,2" CornerRadius="4" Height="32" Padding="10,0">
          <TextBox x:Name="PrefixBox" VerticalAlignment="Center" MaxLength="80" BorderThickness="0" TextChanged="Prefix_Changed"/>
        </Border>
      </StackPanel>

      <DockPanel x:Name="OrderPanel" Margin="0,14,0,0">
        <TextBlock Text="{local:T order}" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Border Style="{StaticResource SegBox}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ByName" Style="{StaticResource Seg}" GroupName="order" Content="{local:T by_name}" Checked="Changed"/>
            <RadioButton x:Name="ByTime" Style="{StaticResource Seg}" GroupName="order" Content="{local:T by_time}" Checked="Changed"/>
          </StackPanel>
        </Border>
      </DockPanel>

      <TextBlock Text="{local:T rn_after}" Style="{StaticResource Lbl}" Margin="0,18,0,6"/>
      <Border Style="{StaticResource CardBorder}">
        <ItemsControl x:Name="Rows" MaxHeight="230" Grid.IsSharedSizeScope="True" ItemTemplate="{StaticResource PreviewRow}">
          <ItemsControl.Template>
            <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
          </ItemsControl.Template>
        </ItemsControl>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
