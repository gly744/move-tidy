<Window x:Class="MoveTidy.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoveTidy"
        Style="{StaticResource WinBase}"
        Title="{local:T app}" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" ShowActivated="False">
  <Border Margin="14" Background="{StaticResource Win}" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
    </Border.Effect>
    <StackPanel Margin="16,14,16,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="IconBox" Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentSoft}">
          <TextBlock x:Name="StatusIcon" Text="&#xE8DE;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Accent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="TitleText" Grid.Column="1" FontWeight="SemiBold" FontSize="14" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="CloseX" Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" Click="Close_Click" ToolTip="{local:T close}"/>
      </Grid>
      <TextBlock x:Name="PathText" Margin="0,8,0,10" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis"/>
      <Grid Height="6">
        <Border Background="{StaticResource Line}" CornerRadius="3"/>
        <Border x:Name="Bar" Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
      </Grid>
      <Grid Margin="0,8,0,0">
        <TextBlock x:Name="LeftText" Foreground="{StaticResource Muted}" FontSize="12"/>
        <TextBlock x:Name="RightText" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
      </Grid>
      <ItemsControl x:Name="FailList" Margin="0,10,0,0" Visibility="Collapsed" MaxHeight="140">
        <ItemsControl.Template>
          <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource ErrBg}" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrFg}" FontSize="11.5" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed">
        <Button Content="{local:T open_folder}" Click="Open_Click" Margin="0,0,8,0"/>
        <Button Content="{local:T close}" Style="{StaticResource PriBtn}" Click="Close_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
